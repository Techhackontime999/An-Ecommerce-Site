# =============================================================================
# Django E-Commerce Site - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For local dev: set DJANGO_ENV=local (default). A SQLite DB will be used.
# For production: set DJANGO_ENV=production and provide DATABASE_URL.
# =============================================================================

# --- Django Core ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-in-production
# Set to 'production' on Render/cloud. Defaults to 'local' for development.
DJANGO_ENV=local

# --- Database ---
# Leave empty for SQLite (local dev).
# For PostgreSQL / Supabase on Render, set the internal database URL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Superuser (auto-created on first deploy) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme123

# --- Razorpay Payment Gateway ---
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# --- Production Hosts ---
# Comma-separated list of allowed hostnames (Render auto-detects via RENDER_EXTERNAL_URL)
# ALLOWED_HOSTS=shop-seed.onrender.com,yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://shop-seed.onrender.com,https://yourdomain.com

# --- Production Security ---
# Set to False if behind a proxy that handles SSL termination
SECURE_SSL_REDIRECT=True

# --- AWS SES (optional - for transactional emails) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1

# --- SMTP Email (optional - real delivery) ---
# Gmail example: generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=Shop-Seed <you@gmail.com>

# --- AWS S3 (optional - for media file storage) ---
AWS_STORAGE_BUCKET_NAME=

# --- Render / Heroku (optional - usually set automatically) ---
PORT=8000
