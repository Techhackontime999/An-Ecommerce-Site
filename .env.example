# =============================================================================
# Django E-Commerce Site - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   - Local dev:    keep DJANGO_ENV=local (default). SQLite is used.
#   - Production:   set DJANGO_ENV=production and provide DATABASE_URL.
# =============================================================================

# --- Django Core ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-this-in-production
# Set to 'production' on Render/cloud. Defaults to 'local' for development.
DJANGO_ENV=local

# --- Field encryption (REQUIRED in production) ---
# Base64 Fernet key used to encrypt courier API credentials. The site will not
# start in production without it. Generate one (and keep it stable — rotating
# it invalidates stored credentials):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database ---
# Leave empty for SQLite (local dev).
# For PostgreSQL / Supabase on Render, set the internal database URL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Cache & Sessions ---
# Production defaults to Django's DatabaseCache (table created automatically by
# setup.sh) with DB-backed sessions. Set REDIS_URL to a managed Redis instance
# for much better performance; when set, Redis also powers sessions via the
# cached_db backend (sessions fall back to the DB, so a Redis restart never
# logs anyone out). Optional: REDIS_DB selects the logical DB number (default 0).
# REDIS_URL=rediss://default:password@host:6379
# REDIS_DB=0
# Tuning for the DatabaseCache fallback only:
# CACHE_MAX_ENTRIES=1000
# CACHE_CULL_FREQUENCY=3

# --- Superuser (auto-created on first deploy) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme123

# --- Razorpay Payment Gateway ---
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# REQUIRED in production. Set a dedicated webhook secret on the Razorpay
# dashboard (Settings → Webhooks). Without it, payment webhooks are rejected.
RAZORPAY_WEBHOOK_SECRET=
# Currency used for Razorpay charges. The site is INR-based (prices are stored
# and charged in INR), so leave as INR.
PAYMENTS_CURRENCY=INR

# --- Courier/LMS Webhook Secrets (REQUIRED in production) ---
# Each active courier must have a secret so its webhooks can be verified.
# Webhooks are REJECTED when no secret is configured (fail-closed).
MOCK_COURIER_WEBHOOK_SECRET=
MOCKEXPRESS_COURIER_WEBHOOK_SECRET=
DELHIVERY_WEBHOOK_SECRET=

# --- Logistics (LMS) defaults ---
LOGISTICS_AWB_PREFIX=SSD
LOGISTICS_DEFAULT_CURRENCY=INR
LOGISTICS_COURIER_TIMEOUT_SECONDS=30
LOGISTICS_COURIER_MAX_RETRIES=3
LOGISTICS_COURIER_RETRY_BACKOFF=2
LOGISTICS_SHIPMENT_FALLBACK_ATTEMPTS=3
LOGISTICS_PICKUP_AUTOSCHEDULE=True
# Public base URL for courier tracking pages (optional)
# LOGISTICS_TRACKING_BASE_URL=

# --- Order configuration ---
# Tax rate applied to items + shipping as a decimal fraction (0.18 = 18% GST).
ORDER_TAX_RATE=0.18

# --- Production Hosts ---
# SITE_URL is your canonical site URL — it is used in emails, invoices, payment
# links and order tracking. Set it to your real domain in production.
# Render auto-detects the host via RENDER_EXTERNAL_URL. When deploying
# elsewhere, set SITE_URL and the allow-list explicitly (comma-separated):
# SITE_URL=https://shop-seed.yourdomain.com
# ALLOWED_HOSTS=shop-seed.yourdomain.com,www.shop-seed.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://shop-seed.yourdomain.com

# Django admin is mounted under this path. Set a random, unguessable segment in
# production so scanner bots cannot find /admin/. Default: admin/
# ADMIN_URL=admin/

# --- Production Security (production.py only) ---
# Set to False if behind a proxy that already handles SSL termination.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Sentry Error Tracking (optional) ---
# Report errors and (optionally) performance traces to Sentry. Leave SENTRY_DSN
# empty to disable entirely (the SDK is never initialized). Get a DSN from your
# Sentry project: https://sentry.io/settings/projects/
# SENTRY_DSN=https://xxxxxxxxxxxxxxxx@o1.ingest.sentry.io/123456
# Optional: defaults to 'development' (DJANGO_ENV=local) or 'production'.
# SENTRY_ENVIRONMENT=production
# Sampling rate for performance traces (0.0-1.0); 0 disables tracing.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag shown in Sentry. Render sets RENDER_GIT_COMMIT automatically; on
# other platforms export GIT_SHA (e.g. the deployed commit).
# GIT_SHA=

# --- Email (optional - real delivery) ---
# Locally, when SMTP is unconfigured, emails are printed to the console.
# Gmail example: generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=Shop-Seed <you@gmail.com>
# Optional override (e.g. django.core.mail.backends.console.EmailBackend)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP connection timeout (seconds) so a dead relay can never hang the worker.
# EMAIL_TIMEOUT=15

# --- Async worker (DB-backed job queue) ---
# Emails, fulfilment runs and gateway refund retries are enqueued as durable
# jobs and drained by `python manage.py run_worker` (see the jobs app). These
# tune retries and the crash-safe lease; defaults are fine for most stores.
# JOB_MAX_ATTEMPTS=5
# JOB_LEASE_SECONDS=300
# JOB_BACKOFF_SECONDS=30

# --- AWS (media + optional SES) ---
# REQUIRED in production for persistent media. Without a bucket, uploaded
# product/blog/review images live on the server's ephemeral disk and are lost
# on every redeploy.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=your-media-bucket
# AWS_S3_REGION_NAME=ap-south-1
# Region fallback used when AWS_S3_REGION_NAME is unset (legacy SES key):
# AWS_SES_REGION=ap-south-1

# --- Exchange Rates (live currency conversion) ---
# Prices are stored and charged in INR (the site's base currency) and converted
# at live rates for display. By default the site uses the free open.er-api.com
# (no key, updated daily). You can point at any API that returns a JSON object
# with a "rates" dict keyed by ISO codes.
# Use {base} as a placeholder for the base currency (INR).
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/{base}
EXCHANGE_RATE_API_KEY=
# How long (in hours) fetched rates are cached before refreshing.
EXCHANGE_RATE_CACHE_HOURS=12

# --- Dev server port (Render / Heroku usually set this automatically) ---
PORT=8000
